{
  "name": "brewvault",
  "version": "0.2.6",
  "description": "Render Markdown notes into Homebrewery-style D&D 5e documents inside Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs watch",
    "build:css": "node scripts/build-css.mjs production",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "eslint .",
    "lint:css": "npm run build:css && stylelint \"styles/**/*.css\" styles.css --max-warnings 0 --report-descriptionless-disables",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run lint && npm run lint:css && npm run test && npm run build",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "homebrewery",
    "dnd"
  ],
  "author": "luiserivaldo",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "^1.5.7",
    "stylelint": "^17.14.1",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "tslib": "2.6.2",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.59.1"
  },
  "dependencies": {
    "@codemirror/view": "^6.38.6",
    "markdown-it": "^14.1.0"
  }
}
